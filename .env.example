# Port, unter dem MemoDrop erreichbar ist (http://localhost:8080)
MEMODROP_PORT=8080

# Whisper-Modell: tiny, base, small, medium, large-v3 (größer = genauer, aber langsamer)
WHISPER_MODEL=small
# Sprache der Aufnahmen (leer lassen = automatische Erkennung)
WHISPER_LANGUAGE=de

# Optionales Token für den Webhook. Wenn gesetzt, muss der Aufrufer es
# als Header "X-Webhook-Token: <token>" oder als ?token=<token> mitschicken.
# openssl rand -hex 32
WEBHOOK_TOKEN=

# Send-Endpoint des Signal-Bots. Body: {"recipient": "...", "message": "<Transkript>"}
# Läuft der Bot direkt auf demselben Rechner (nicht in Docker): host.docker.internal
# Leer = Senden deaktiviert.
FORWARD_URL=http://host.docker.internal:3030/send
# Optional: wird als "Authorization: Bearer <token>" mitgeschickt
FORWARD_TOKEN=
# Empfänger, falls eine Notiz keinen Absender hat (z. B. Upload über die Weboberfläche)
DEFAULT_RECIPIENT=
# Transkript nach der ersten Transkription automatisch zurückschicken
AUTO_SEND=true

MAX_UPLOAD_MB=200
TZ=Europe/Berlin
